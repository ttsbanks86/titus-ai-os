<style>
:root{--bg:#080b14;--surface:#0f1119;--border:rgba(255,255,255,0.04);--text:#e4e8ee;--text-secondary:#6b7280;--accent:#7c3aed;--accent-light:#a78bfa;--radius:12px;--max-w:1100px}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased}
.container{max-width:var(--max-w);margin:0 auto;padding:0 24px}

/* Nav */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(8,11,20,0.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
nav .container{display:flex;align-items:center;justify-content:space-between;height:56px}
.logo{font-weight:700;font-size:15px;letter-spacing:-0.3px}
.logo span{color:var(--accent-light)}
.nav-links{display:flex;gap:24px;list-style:none}
.nav-links a{text-decoration:none;color:var(--text-secondary);font-size:13px;font-weight:500;transition:.15s;padding:4px 0;border-bottom:1px solid transparent}
.nav-links a:hover{color:var(--text);border-color:var(--accent-light)}
.resume-btn{padding:6px 16px;background:var(--accent);color:#fff!important;border-radius:6px;font-size:12px!important;font-weight:600!important;border:none;cursor:pointer;transition:.2s}
.resume-btn:hover{background:var(--accent-light)!important;box-shadow:0 4px 16px rgba(124,58,237,0.3)}

/* Hero */
.hero{padding:120px 0 60px;text-align:center}
.hero h1{font-size:48px;font-weight:800;letter-spacing:-1px;line-height:1.1;margin-bottom:12px}
.hero h1 span{background:linear-gradient(135deg,var(--accent-light),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero .subtitle{font-size:18px;color:var(--text-secondary);max-width:600px;margin:0 auto 24px;font-weight:400}
.hero .tags{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:28px}
.hero .tag{padding:4px 14px;background:rgba(124,58,237,0.08);border:1px solid rgba(124,58,237,0.12);border-radius:20px;font-size:12px;color:var(--accent-light);font-weight:500}
.hero-links{display:flex;gap:12px;justify-content:center}
.hero-links a{padding:10px 24px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:.2s}
.hero-links .primary{background:var(--accent);color:#fff}
.hero-links .primary:hover{background:#8b5cf6;box-shadow:0 4px 20px rgba(124,58,237,0.3)}
.hero-links .secondary{border:1px solid var(--border);color:var(--text)}
.hero-links .secondary:hover{border-color:var(--accent-light);color:var(--accent-light)}

/* Sections */
section{padding:60px 0;border-bottom:1px solid var(--border)}
section:last-child{border-bottom:none}
.section-title{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--accent-light);margin-bottom:8px}
.section-heading{font-size:28px;font-weight:700;letter-spacing:-0.5px;margin-bottom:24px}

/* About */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.about-text{font-size:15px;color:#c8ced6;line-height:1.8}
.about-text strong{color:var(--text)}
.about-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.stat-box{padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);text-align:center}
.stat-num{font-size:28px;font-weight:800;color:var(--accent-light);letter-spacing:-0.5px}
.stat-lbl{font-size:11px;color:var(--text-secondary);margin-top:4px}

/* Skills */
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.skill-card{padding:14px;background:var(--surface);border:1px solid var(--border);border-radius:8px;font-size:13px}
.skill-card .skill-name{font-weight:600;margin-bottom:4px}
.skill-card .skill-level{font-size:11px;color:var(--text-secondary)}
.skill-bar{height:4px;background:rgba(255,255,255,0.04);border-radius:2px;margin-top:8px;overflow:hidden}
.skill-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--accent),var(--accent-light))}

/* Projects */
.projects-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.project-card{padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);transition:.2s}
.project-card:hover{border-color:rgba(124,58,237,0.15);transform:translateY(-1px)}
.project-icon{font-size:24px;margin-bottom:8px}
.project-name{font-size:14px;font-weight:700;margin-bottom:4px}
.project-desc{font-size:12px;color:var(--text-secondary);line-height:1.6;margin-bottom:8px}
.project-tech{display:flex;gap:4px;flex-wrap:wrap}
.project-tech span{padding:2px 8px;background:rgba(124,58,237,0.06);border-radius:4px;font-size:9px;color:var(--accent-light)}
.project-link{font-size:11px;color:var(--accent-light);text-decoration:none;margin-top:8px;display:inline-block}
.project-link:hover{text-decoration:underline}

/* Experience */
.timeline{display:flex;flex-direction:column;gap:16px}
.timeline-item{padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);position:relative;padding-left:48px}
.timeline-item::before{content:'';position:absolute;left:20px;top:24px;width:8px;height:8px;border-radius:50%;background:var(--accent-light);border:2px solid var(--bg)}
.timeline-item::after{content:'';position:absolute;left:23px;top:36px;width:2px;bottom:24px;background:var(--border)}
.timeline-item:last-child::after{display:none}
.timeline-title{font-size:14px;font-weight:700}
.timeline-company{font-size:12px;color:var(--accent-light);margin-bottom:4px}
.timeline-date{font-size:11px;color:var(--text-secondary);margin-bottom:6px}
.timeline-desc{font-size:12px;color:#c8ced6;line-height:1.6}

/* Education */
.edu-card{padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);display:flex;align-items:flex-start;gap:16px}
.edu-icon{width:44px;height:44px;background:rgba(124,58,237,0.08);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.edu-name{font-size:15px;font-weight:700;margin-bottom:2px}
.edu-school{font-size:12px;color:var(--accent-light);margin-bottom:2px}
.edu-date{font-size:11px;color:var(--text-secondary)}

/* Contact */
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.contact-card{padding:20px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);text-align:center;text-decoration:none;color:var(--text);transition:.2s}
.contact-card:hover{border-color:rgba(124,58,237,0.15);transform:translateY(-1px)}
.contact-icon{font-size:24px;margin-bottom:8px}
.contact-label{font-size:12px;font-weight:600}
.contact-value{font-size:11px;color:var(--text-secondary);margin-top:4px}

/* Footer */
footer{padding:24px 0;text-align:center;font-size:11px;color:var(--text-secondary)}
footer a{color:var(--accent-light);text-decoration:none}

/* Responsive */
@media(max-width:768px){
  .hero h1{font-size:32px}
  .about-grid,.contact-grid,.projects-grid{grid-template-columns:1fr}
  .skills-grid{grid-template-columns:repeat(2,1fr)}
  .about-stats{grid-template-columns:repeat(3,1fr)}
}

/* Animations */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.hero,.section-heading{animation:fadeUp .6s ease-out}
</style>
</head>
