  "segments": [
    {
      "text": "God sees exactly where you are right now.",
      "start": 0.5,
      "end": 3.45
    },
    {
      "text": "Even when you feel invisible, He knows your name.",
      "start": 3.55,
      "end": 7.07
    },
    {
      "text": "Sometimes we think God has forgotten us because our prayers feel silent.",
      "start": 7.17,
      "end": 12.35
    },
    {
      "text": "But silence does not mean absence.",
      "start": 12.45,
      "end": 14.92
    },
    {
      "text": "God is working in ways you cannot see yet.",
      "start": 15.02,
      "end": 18.02
    },
    {
      "text": "He is moving behind the scenes, arranging things for your good.",
      "start": 18.12,
      "end": 22.65
    },
    {
      "text": "Do not give up on what God started in your life.",
      "start": 22.75,
      "end": 26.15
    },
    {
      "text": "Do not lose hope when things take longer than expected.",
      "start": 26.25,
      "end": 30.2
    },
    {
      "text": "Your breakthrough is closer than you realize.",
      "start": 30.3,
      "end": 33.58
    },
    {
      "text": "Keep trusting even when it is hard.",
      "start": 33.68,
      "end": 36.2
    },
    {
      "text": "Keep believing even when you cannot see the way forward.",
      "start": 36.3,
      "end": 40.33
    },
    {
      "text": "God is faithful even when we cannot feel His hand.",
      "start": 40.43,
      "end": 44.0
    },
    {
      "text": "He is with you in the waiting.",
      "start": 44.1,
      "end": 46.25
    },
    {
      "text": "Thank you for listening.",
      "start": 46.35,
      "end": 48.35
    },
    {
      "text": "This is The Open Door with Eden.",
      "start": 48.45,
      "end": 50.75
    }
  ],
  "word_count": 128
}