# Titus AI OS - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# OpenRouter API Key (for AI model access)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telegram Bot Token (for Hermes bot)
HERMES_TELEGRAM_TOKEN=your_telegram_bot_token_here

# Notion API Token (for knowledge base integration)
NOTION_TOKEN=your_notion_api_token_here

# GitHub Personal Access Token (for repository access)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Tavily API Key (for web search)
TAVILY_API_KEY=your_tavily_api_key_here

# AWS Credentials (for cloud services)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
