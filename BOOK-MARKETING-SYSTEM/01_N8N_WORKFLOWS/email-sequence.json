{
  "name": "Email Sequence - Book Launch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1,3,5"
            }
          ]
        }
      },
      "name": "Pre-Launch Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "filePath": "C:\\Users\\tbank\\Desktop\\Live Cowork\\BOOK-MARKETING-SYSTEM\\02_EMAIL_SEQUENCES\\pre-launch-sequence.md"
      },
      "name": "Read Sequence",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.emailNumber }}",
              "operation": "equals",
              "value2": "1"
            }
          ]
        }
      },
      "name": "Check Email Number",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "fromEmail": "bonolo@rhpublishing.com",
        "toEmail": "={{ $json.subscriberEmail }}",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.body }}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "email_sent"
            }
          ]
        }
      },
      "name": "Log Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "email_failed"
            }
          ]
        }
      },
      "name": "Log Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 400]
    }
  ],
  "connections": {
    "Pre-Launch Trigger": {
      "main": [
        [
          {
            "node": "Read Sequence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Sequence": {
      "main": [
        [
          {
            "node": "Check Email Number",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Email Number": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}
