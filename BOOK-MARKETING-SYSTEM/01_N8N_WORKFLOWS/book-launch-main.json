{
  "name": "Book Launch - Struck Down but Not Destroyed",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "filePath": "C:\\Users\\tbank\\Desktop\\Live Cowork\\BOOK-MARKETING-SYSTEM\\02_EMAIL_SEQUENCES\\pre-launch-sequence.md"
      },
      "name": "Read Email Sequence",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.day }}",
              "operation": "equals",
              "value2": "1"
            }
          ]
        }
      },
      "name": "Check Launch Day",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "fromEmail": "bonolo@rhpublishing.com",
        "toEmail": "={{ $json.subscriberEmail }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body }}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 200]
    },
    {
      "parameters": {
        "channel": "#book-launch",
        "text": "📚 Launch Update: {{ $json.message }}"
      },
      "name": "Notify Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [880, 400],
      "disabled": true
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "email_sent"
            }
          ]
        }
      },
      "name": "Log Activity",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Daily Trigger": {
      "main": [
        [
          {
            "node": "Read Email Sequence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Email Sequence": {
      "main": [
        [
          {
            "node": "Check Launch Day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Launch Day": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Log Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}
