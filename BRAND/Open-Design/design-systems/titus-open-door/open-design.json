{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "design-system-titus-open-door",
  "title": "Titus Open Door",
  "version": "0.1.0",
  "description": "Faith-rooted AI operations and executive systems. Deep navy, measured gold, warm cream, practical copy, and professional command-center clarity.",
  "license": "Private/Internal",
  "tags": [
    "design-system",
    "internal",
    "titus-banks",
    "open-door-ai-systems",
    "executive-systems",
    "faith-rooted"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "design-system",
    "scenario": "design",
    "surface": "web",
    "useCase": {
      "query": {
        "en": "Generate a {{artifactKind}} using the Titus Open Door design system. Stay faithful to the navy, gold, cream, typography, spacing, accessibility, faith-rooted values, and practical voice documented in DESIGN.md."
      }
    },
    "inputs": [
      {
        "name": "artifactKind",
        "label": "Artifact kind",
        "type": "select",
        "options": [
          "landing page",
          "dashboard",
          "marketing site",
          "app screen",
          "book launch page",
          "presentation deck",
          "social graphic"
        ],
        "default": "landing page"
      },
      {
        "name": "brief",
        "label": "Brief",
        "type": "text",
        "placeholder": "What should the asset communicate, and what action should the audience take?"
      }
    ],
    "context": {
      "designSystem": {
        "ref": "titus-open-door",
        "primary": true
      },
      "assets": [
        "./DESIGN.md"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
